# =====================================================================
# T-10
# Додаткова нетривіальна предметна перевірка
#
# Правило:
# description після Trim()
# не може повністю дорівнювати title після Trim().
#
# Порушення -> 400 + errors.description.
# Допустимий стан -> 201.
# =====================================================================

### T-10 negative
### description == title після Trim — 400
POST {{host}}/api/incidents
Content-Type: application/json
Accept: application/problem+json

{
  "title": "  T-10 однаковий текст  ",
  "description": "  T-10 однаковий текст  ",
  "severity": "Low",
  "occurredAtUtc": "2026-09-30T08:00:00Z"
}


### T-10 positive — 201 [СТВОРЮЄ]
POST {{host}}/api/incidents
Content-Type: application/json
Accept: application/json

{
  "title": "T-10 опис з додатковими фактами",
  "description": "Опис пояснює обставини інциденту та містить додаткові факти.",
  "severity": "Low",
  "occurredAtUtc": "2026-09-30T08:00:00Z"
}



# =====================================================================
# S-01 / S-02
# SQL injection: vulnerable state та fixed retest
#
# Використовується ТОЙ САМИЙ контрольований read-only input.
#
# q = zz-no-match' OR TRUE -- [пробіл наприкінці]
#
# [VULN]
# vulnerable commit:
# небажане розширення вибірки.
#
# [FIXED]
# fixed commit:
# 200 та точна порожня множина [].
#
# Не додавати інші SQL statements.
# =====================================================================

### S-01 / S-02 негативний контроль
### q = zz-no-match
### Очікується []
GET {{host}}/api/incidents/search?q=zz-no-match
Accept: application/json


### S-01 / S-02 контрольований read-only input
###
### [VULN]
### зафіксувати фактичний status,
### кількість та ID повернених записів.
###
### [FIXED]
### 200 і []
###
### q = zz-no-match' OR TRUE -- [пробіл наприкінці]
GET {{host}}/api/incidents/search?q=zz-no-match%27%20OR%20TRUE%20--%20
Accept: application/json



# =====================================================================
# A-01
# Повний огляд data-access points
#
# Це не HTTP-запити.
# Виконувати з кореня репозиторію.
# =====================================================================

### A-01 raw SQL / ORDER BY scan
# PowerShell / git:
#
# git grep -n -e FromSqlRaw -e ExecuteSqlRaw -e "ORDER BY" -- src tests


### A-01 interpolated SELECT scan
#
# git grep -n -F '$"SELECT' -- src tests


### A-01 concatenation scan
#
# git grep -n -F '+ query' -- src tests


### A-01 для повного рівня
### додатково переглянути всі точки доступу до БД:
###
### - IncidentQueries
### - Lab02Endpoints
### - DatabaseBootstrap
### - DbSeeder
### - Lab02Seed
### - тести, які напряму використовують DbContext
###
### Для кожної точки в звіті:
### файл / метод
### категорія
### джерело значень
### висновок щодо SQL injection.



# =====================================================================
# A-02
# Mass assignment / overposting
#
# Клієнт навмисно надсилає:
# id
# ownerUserId
# status
# createdAtUtc
#
# Вони server-managed і не повинні керувати entity.
#
# Очікується:
#
# response:
# - 201
# - id != 11111111-...
# - status = New
# - createdAtUtc встановлений сервером
# - ownerUserId відсутній
#
# database:
# - OwnerUserId = Alice
# - Status = New
# - client supplied id відсутній
#
# GET details:
# - status = New
# - ownerDisplayName = "Аліса Коваль"
# - ownerUserId не розкривається
# =====================================================================

### A-02 POST із server-managed полями — 201 [СТВОРЮЄ]
POST {{host}}/api/incidents
Content-Type: application/json
Accept: application/json

{
  "id": "11111111-1111-1111-1111-111111111111",
  "ownerUserId": "22222222-2222-2222-2222-222222222222",
  "status": "Closed",
  "createdAtUtc": "2020-01-01T00:00:00Z",
  "title": "MassAssign-manual-0001",
  "description": "Опис для перевірки mass assignment на створенні.",
  "severity": "Low",
  "occurredAtUtc": "2026-09-30T08:00:00Z"
}


### A-02 GET створеного запису
### Підставити id, отриманий із POST вище.
###
### Очікується:
### status = "New"
### ownerDisplayName = "Аліса Коваль"
### ownerUserId відсутній
#
# GET {{host}}/api/incidents/<id-зі-відповіді>
# Accept: application/json